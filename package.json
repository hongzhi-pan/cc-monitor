{
  "name": "cc-monitor",
  "private": true,
  "bin": {
    "ccm": "bin/ccm.mjs"
  },
  "workspaces": [
    "server",
    "web",
    "cli"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "start": "npm run start -w server",
    "attach": "npm run attach -w cli --"
  }
}
